# S2Admin 前端环境变量配置
# 复制此文件为 .env.local 并修改对应值

# API 基础地址 (后端服务地址)
# 开发环境
PUBLIC_API_BASE_URL=http://localhost:8080
# 生产环境示例: https://api.example.com

# 应用名称
PUBLIC_APP_NAME=S2Admin

# 是否启用 Mock 数据 (true/false)
PUBLIC_USE_MOCK=false

# 分页默认每页条数
PUBLIC_DEFAULT_PAGE_SIZE=10

# Token 存储键名
PUBLIC_TOKEN_KEY=s2admin_token
PUBLIC_REFRESH_TOKEN_KEY=s2admin_refresh_token
